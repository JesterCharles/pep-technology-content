  "simulatorEdges": [
    {
      "name": "the next activity stays locked until the current activity is checked",
      "actions": [
        {
          "do": "expectDisabled",
          "selector": "#next-activity"
        },
        {
          "do": "expectAttribute",
          "selector": "#activity-1",
