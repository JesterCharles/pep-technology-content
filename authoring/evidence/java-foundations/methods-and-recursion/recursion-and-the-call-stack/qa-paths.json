  "simulatorEdges": [
    {
      "name": "Checking without an answer and confidence records no attempt, completion or credit",
      "actions": [
        {
          "do": "click",
          "selector": "#check-1"
        },
        {
          "do": "expectAttribute",
          "selector": "#activity-1",
          "attribute": "data-pep-attempts",
          "equals": "0"
