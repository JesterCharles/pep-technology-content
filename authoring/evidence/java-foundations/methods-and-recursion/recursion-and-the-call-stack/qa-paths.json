    "wrongTwice": [
      {
        "do": "check",
        "selector": "#a1-b"
      },
      {
        "do": "check",
        "selector": "#a1-conf-1"
      },
      {
        "do": "click",
        "selector": "#check-1"
      },
      {
        "do": "check",
        "selector": "#a1-d"
      },
      {
        "do": "check",
        "selector": "#a1-conf-0"
      },
      {
        "do": "click",
        "selector": "#check-1"
      },
      {
        "do": "expectAttribute",
        "selector": "#activity-1",
        "attribute": "data-pep-attempts",
        "equals": "2"
