        {
          "do": "click",
          "selector": "#next-activity"
        },
        {
          "do": "fill",
          "selector": "#code-3",
          "value": "public class Main {\n  static int calls = 0;\n  static int f(int n) {\n    calls++;\n    if (calls >= 3) { return 0; }\n    return f(n);\n  }\n  public static void main(String[] args) {\n    System.out.println(f(5));\n  }\n}\n"
        },
        {
          "do": "check",
          "selector": "#a3-conf-1"
        },
        {
          "do": "click",
          "selector": "#check-3"
        },
        {
          "do": "expectAttribute",
          "selector": "#activity-3",
          "attribute": "data-pep-completed",
          "equals": "false"
        },
        {
          "do": "expectAttribute",
          "selector": "#activity-3",
          "attribute": "data-pep-credit",
          "equals": "0"
        },
        {
          "do": "expectText",
          "selector": "#feedback-3",
          "text": "Missing"
        }
      ]
    }
