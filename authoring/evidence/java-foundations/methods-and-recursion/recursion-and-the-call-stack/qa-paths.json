{
  "schemaVersion": 1,
  "completion": {
    "selector": "#lesson",
    "attribute": "data-pep-complete",
    "equals": "false"
  },
  "progress": {
    "selector": "#progress-text",
    "text": "0 of 3 done"
  },
  "routes": {
    "success": [
      {
        "do": "click",
        "selector": "#check-1"
      },
      {
        "do": "expectAttribute",
        "selector": "#activity-1",
        "attribute": "data-pep-attempts",
        "equals": "0"
      },
      {
        "do": "expectAttribute",
        "selector": "#activity-1",
        "attribute": "data-pep-completed",
        "equals": "false"
      },
      {
        "do": "expectAttribute",
        "selector": "#activity-1",
        "attribute": "data-pep-credit",
        "equals": "0"
      },
      {
        "do": "expectDisabled",
        "selector": "#next-activity"
      }
    ],
    "wrongFirst": [
      {
        "do": "check",
        "selector": "#a1-b"
      },
      {
        "do": "check",
        "selector": "#a1-conf-1"
      },
      {
        "do": "click",
        "selector": "#check-1"
      },
      {
        "do": "expectAttribute",
        "selector": "#activity-1",
        "attribute": "data-pep-attempts",
        "equals": "1"
