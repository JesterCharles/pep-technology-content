          "attribute": "data-pep-credit",
          "equals": "0"
        },
        {
          "do": "expectEnabled",
          "selector": "#next-activity"
        }
      ]
    },
    {
      "name": "Recursion with an unchanged argument and unrelated shared counter is rejected",
      "actions": [
        {
          "do": "check",
          "selector": "#a1-b"
        },
        {
          "do": "check",
          "selector": "#a1-conf-1"
        },
        {
          "do": "click",
          "selector": "#check-1"
        },
        {
          "do": "check",
          "selector": "#a1-d"
        },
        {
          "do": "check",
          "selector": "#a1-conf-0"
        },
        {
          "do": "click",
          "selector": "#check-1"
        },
        {
          "do": "click",
          "selector": "#next-activity"
        },
        {
          "do": "check",
          "selector": "#a2-d"
        },
        {
          "do": "check",
          "selector": "#a2-conf-1"
        },
        {
          "do": "click",
          "selector": "#check-2"
        },
        {
          "do": "check",
          "selector": "#a2-a"
