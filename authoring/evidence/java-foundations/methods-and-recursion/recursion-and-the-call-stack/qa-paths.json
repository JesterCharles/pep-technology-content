          "do": "check",
          "selector": "#a1-conf-0"
        },
        {
          "do": "click",
          "selector": "#check-1"
        },
        {
          "do": "expectAttribute",
          "selector": "#activity-1",
          "attribute": "data-pep-attempts",
          "equals": "2"
        },
        {
          "do": "expectAttribute",
          "selector": "#activity-1",
          "attribute": "data-pep-settled",
          "equals": "true"
