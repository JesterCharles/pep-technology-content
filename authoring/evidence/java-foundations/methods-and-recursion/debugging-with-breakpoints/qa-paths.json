        {
          "do": "click",
          "selector": "#check-1"
        },
        {
          "do": "click",
          "selector": "#next-activity"
        },
        {
          "do": "click",
          "selector": "#activity-2 [data-bp=\"16\"]"
        },
        {
          "do": "click",
          "selector": "#debug-2"
        },
        {
          "do": "expectText",
          "selector": "#activity-2 .pep-trace__status",
          "text": "before line 16"
        },
        {
          "do": "click",
          "selector": "#into-2"
        },
        {
          "do": "expectText",
          "selector": "#activity-2 .pep-trace__status",
          "text": "before line 3"
        },
        {
          "do": "click",
          "selector": "#out-2"
        },
        {
          "do": "expectText",
          "selector": "#activity-2 .pep-trace__status",
          "text": "Back on line 16"
        }
      ]
    }
  ],
