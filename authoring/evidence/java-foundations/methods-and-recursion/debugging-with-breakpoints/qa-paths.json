  "simulatorEdges": [
    {
      "name": "Check without choosing an answer gives a fix-it message and no attempt",
      "actions": [
        {
          "do": "click",
          "selector": "#check-1"
        },
        {
          "do": "expectText",
          "selector": "#feedback-1",
          "text": "Not checked yet"
        },
        {
          "do": "expectAttribute",
          "selector": "#activity-1",
          "attribute": "data-pep-attempts",
          "equals": "0"
        },
        {
          "do": "expectDisabled",
          "selector": "#next-activity"
        }
      ]
    },
    {
      "name": "Step controls before a debug session starts explain what to do first",
      "actions": [
        {
          "do": "check",
          "selector": "#a1-b"
        },
        {
          "do": "check",
          "selector": "#a1-conf-1"
