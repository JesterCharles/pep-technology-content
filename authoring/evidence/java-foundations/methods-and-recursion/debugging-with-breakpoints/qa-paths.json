          "selector": "#next-activity"
        },
        {
          "do": "click",
          "selector": "#over-2"
        },
        {
          "do": "expectText",
          "selector": "#activity-2 .pep-trace__status",
          "text": "Start a debug session first"
        },
        {
          "do": "click",
          "selector": "#debug-2"
        },
        {
          "do": "expectText",
          "selector": "#activity-2 .pep-trace__status",
          "text": "finished"
        }
      ]
    },
    {
      "name": "Step Into enters total from main and Step Out returns to the caller line",
      "actions": [
        {
          "do": "check",
          "selector": "#a1-b"
        },
        {
          "do": "check",
          "selector": "#a1-conf-1"
