          "do": "fill",
          "selector": "#code-2",
          "value": "public class Main {\n    static int size(String s) {\n        return s.length();\n    }\n\n    static double size(String s) {\n        return s.length();\n    }\n\n    public static void main(String[] args) {\n        System.out.println(size(\"hi\"));\n    }\n}\n"
        },
        {
          "do": "click",
          "selector": "#run-2"
        },
        {
          "do": "expectText",
          "selector": "#problems-2",
          "text": "method size\\(String\\) is already defined in class Main"
        },
        {
          "do": "expectAttribute",
          "selector": "#activity-2",
          "attribute": "data-pep-attempts",
          "equals": "0"
        }
      ]
    },
