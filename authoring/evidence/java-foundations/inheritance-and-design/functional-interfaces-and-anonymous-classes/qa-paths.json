  "simulatorEdges": [
    {
      "name": "an empty editor reports a problem and does not complete the activity",
      "actions": [
        {
          "do": "check",
          "selector": "input[name=predict][value=\"err\"]"
        },
        {
          "do": "check",
          "selector": "input[name=conf0][value=medium]"
        },
        {
          "do": "expectEnabled",
          "selector": "#predict-check"
        },
        {
          "do": "click",
          "selector": "#predict-check"
        },
        {
          "do": "click",
          "selector": "#next"
        },
        {
          "do": "fill",
          "selector": "#ed",
          "value": ""
        },
        {
          "do": "click",
          "selector": "#run"
        },
        {
          "do": "expectText",
          "selector": "#ed-prob",
          "text": "editor is empty"
        },
        {
          "do": "expectAttribute",
          "selector": "#activity-2",
          "attribute": "data-pep-completed",
          "equals": "false"
        }
      ]
    },
    {
      "name": "a name outside the practice subset is reported as not supported and not counted",
      "actions": [
        {
          "do": "check",
          "selector": "input[name=predict][value=\"err\"]"
        },
        {
          "do": "check",
          "selector": "input[name=conf0][value=medium]"
        },
        {
          "do": "expectEnabled",
          "selector": "#predict-check"
        },
        {
          "do": "click",
          "selector": "#predict-check"
        },
        {
          "do": "click",
          "selector": "#next"
        },
        {
          "do": "fill",
          "selector": "#ed",
          "value": "Unsupported thing;"
        },
        {
          "do": "click",
          "selector": "#run"
        },
        {
          "do": "expectText",
          "selector": "#ed-prob",
          "text": "not supported in this practice editor"
        },
        {
          "do": "expectAttribute",
          "selector": "#activity-2",
          "attribute": "data-pep-attempts",
          "equals": "0"
        }
      ]
    },
    {
      "name": "Reset code restores the starter",
      "actions": [
        {
          "do": "check",
          "selector": "input[name=predict][value=\"err\"]"
        },
        {
          "do": "check",
          "selector": "input[name=conf0][value=medium]"
        },
        {
          "do": "expectEnabled",
          "selector": "#predict-check"
        },
        {
          "do": "click",
          "selector": "#predict-check"
        },
        {
          "do": "click",
          "selector": "#next"
        },
        {
          "do": "fill",
          "selector": "#ed",
          "value": "x"
        },
        {
          "do": "click",
          "selector": "#ed-reset"
        },
        {
          "do": "expectValue",
          "selector": "#ed",
          "value": "// Replace null with an anonymous class that implements Supplier<String>\\."
        },
        {
          "do": "expectText",
          "selector": "#ed-status",
          "text": "^Not run yet$"
        }
      ]
    },
    {
      "name": "a locked activity cannot be opened from the timeline",
      "actions": [
        {
          "do": "press",
          "selector": "#tl-3",
          "key": "Enter"
        },
        {
          "do": "expectAttribute",
          "selector": "#lesson",
          "attribute": "data-pep-current-activity",
          "equals": "1"
        }
      ]
    }
