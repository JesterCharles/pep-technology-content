    },
    {
      "id": "spring-intake-edu-005",
      "severity": "medium",
      "location": {
        "file": "spring-boot/assessments/spring-boot-module-check/blueprint.json",
        "line": 112
      },
      "claim": "The Standard schedule consumes all 45 minutes as 20 scenario MCQs in 20 minutes plus two coding tasks in 25 minutes. The coding rationale itself uses about 24 minutes, leaving one minute for the quiz-to-project transition and no contingency for opening the provided project or a Maven test rerun. The formats and objective bundles are clear, but the duration fit is not yet credible without a pilot.",
