      },
      {
        "do": "press",
        "selector": "#cmd-3",
        "key": "Enter"
      },
      {
        "do": "expectText",
        "selector": "#prog-text",
        "text": " · 3 done"
      },
      {
        "do": "expectVisible",
        "selector": "#next"
      },
      {
        "do": "click",
        "selector": "#next"
      },
      {
        "do": "check",
        "selector": "input[name=apply-a][value=a]"
      },
      {
        "do": "check",
        "selector": "input[name=conf][value=medium]"
