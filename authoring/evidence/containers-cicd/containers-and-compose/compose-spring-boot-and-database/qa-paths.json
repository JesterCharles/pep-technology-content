{
  "schemaVersion": 1,
  "completion": {
    "selector": "#lesson",
    "attribute": "data-pep-complete",
    "equals": "true"
  },
  "progress": {
    "selector": "#prog-text",
    "text": " · (4 done|3 done \\(1 settled, not marked correct\\))$"
  },
  "routes": {
    "success": [
      {
        "do": "check",
        "selector": "input[name=predict][value=a]"
      },
      {
        "do": "check",
        "selector": "input[name=pconf][value=medium]"
      },
      {
        "do": "expectEnabled",
        "selector": "#predict-check"
      },
      {
        "do": "click",
        "selector": "#predict-check"
      },
      {
        "do": "expectVisible",
        "selector": "#next"
      },
      {
        "do": "click",
        "selector": "#next"
      },
      {
        "do": "fill",
        "selector": "#ed-2-input",
        "value": "services:\n  api:\n    build: ./backend\n    ports:\n      - \"127.0.0.1:8080:8080\"\n    environment:\n      SPRING_DATASOURCE_URL: jdbc:postgresql://db:5432/shop\n      SPRING_DATASOURCE_USERNAME: shop\n      SPRING_DATASOURCE_PASSWORD: ${DB_PASSWORD}\n  db:\n    image: postgres:18\n    environment:\n      POSTGRES_DB: shop\n      POSTGRES_USER: shop\n      POSTGRES_PASSWORD: ${DB_PASSWORD}\n    volumes:\n      - pgdata:/var/lib/postgresql\nvolumes:\n  pgdata:\n"
      },
      {
        "do": "click",
        "selector": "#ed-2-run"
      },
      {
        "do": "expectText",
        "selector": "#ed-2-status",
        "text": "All checks pass"
      },
      {
        "do": "expectText",
        "selector": "#prog-text",
        "text": " · 2 done"
      },
      {
        "do": "expectVisible",
        "selector": "#next"
      },
      {
        "do": "click",
        "selector": "#next"
      },
      {
        "do": "fill",
        "selector": "#cmd-3",
        "value": "docker compose up -d"
      },
      {
        "do": "press",
        "selector": "#cmd-3",
        "key": "Enter"
      },
      {
        "do": "fill",
        "selector": "#cmd-3",
        "value": "docker compose ps"
      },
      {
        "do": "press",
        "selector": "#cmd-3",
        "key": "Enter"
      },
      {
        "do": "fill",
        "selector": "#cmd-3",
        "value": "docker compose down"
      },
      {
        "do": "press",
        "selector": "#cmd-3",
        "key": "Enter"
      },
      {
        "do": "fill",
        "selector": "#cmd-3",
        "value": "docker volume ls"
      },
      {
        "do": "press",
        "selector": "#cmd-3",
        "key": "Enter"
      },
      {
        "do": "fill",
