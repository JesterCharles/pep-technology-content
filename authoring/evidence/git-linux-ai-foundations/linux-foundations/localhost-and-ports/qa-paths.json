  "simulatorEdges": [
    {
      "name": "request with no port and to the wrong service",
      "actions": [
        {
          "do": "check",
          "selector": "input[name=predict][value=a]"
        },
        {
          "do": "check",
          "selector": "input[name=pconf][value=medium]"
