  "simulatorEdges": [
    {
      "name": "unsupported commands and flags are refused",
      "actions": [
        {
          "do": "check",
          "selector": "input[name=predict][value=a]"
        },
        {
          "do": "check",
          "selector": "input[name=pconf][value=medium]"
        },
        {
          "do": "expectEnabled",
          "selector": "#predict-check"
        },
        {
          "do": "click",
          "selector": "#predict-check"
