          "value": "grep INFO app.log"
        },
        {
          "do": "press",
          "selector": "#cmd-3",
          "key": "Enter"
        },
        {
          "do": "expectText",
          "selector": "[data-step=\"3\"][data-pep-explore-feedback]",
          "text": "Those are the INFO lines themselves"
