{
  "schemaVersion": 1,
  "completion": {
    "selector": "#lesson",
    "attribute": "data-pep-complete",
    "equals": "true"
  },
  "progress": {
    "selector": "#prog-text",
    "text": "^Activities done: 5 of 5"
  },
  "routes": {
    "success": [
      {
        "do": "check",
        "selector": "input[name=predict][value=a]"
      },
      {
        "do": "check",
        "selector": "input[name=pconf][value=medium]"
      },
      {
        "do": "expectEnabled",
        "selector": "#predict-check"
      },
      {
        "do": "click",
        "selector": "#predict-check"
      },
      {
        "do": "expectVisible",
        "selector": "#next"
      },
      {
        "do": "click",
        "selector": "#next"
      },
      {
        "do": "fill",
        "selector": "#cmd-2",
        "value": "cat app.log | grep ERROR"
      },
      {
        "do": "press",
        "selector": "#cmd-2",
        "key": "Enter"
      },
      {
        "do": "expectText",
        "selector": "#prog-text",
        "text": "^Activities done: 2 of 5"
      },
      {
        "do": "click",
        "selector": "#next"
      },
      {
        "do": "fill",
        "selector": "#cmd-3",
        "value": "grep -v INFO app.log"
      },
      {
        "do": "press",
        "selector": "#cmd-3",
        "key": "Enter"
      },
      {
        "do": "expectText",
        "selector": "#prog-text",
        "text": "^Activities done: 3 of 5"
      },
      {
        "do": "click",
        "selector": "#next"
      },
      {
        "do": "fill",
        "selector": "#cmd-4",
        "value": "grep -i error app.log | wc -l"
      },
      {
        "do": "press",
        "selector": "#cmd-4",
        "key": "Enter"
      },
      {
        "do": "expectText",
        "selector": "#prog-text",
        "text": "^Activities done: 4 of 5"
      },
      {
        "do": "click",
        "selector": "#next"
      },
      {
        "do": "expectText",
        "selector": "#prog-text",
        "text": "^Activities done: 4 of 5"
      },
      {
        "do": "check",
        "selector": "input[name=apply-a][value=d]"
      },
      {
        "do": "expectDisabled",
        "selector": "#apply-check"
      },
      {
        "do": "check",
        "selector": "input[name=conf][value=high]"
      },
      {
        "do": "expectEnabled",
        "selector": "#apply-check"
      },
      {
        "do": "click",
        "selector": "#apply-check"
      },
      {
        "do": "expectText",
        "selector": "[data-pep-apply-feedback]:not([hidden])",
        "text": "Correct"
      },
      {
        "do": "expectText",
        "selector": "#prog-text",
        "text": "^Activities done: 5 of 5"
      },
      {
        "do": "click",
        "selector": "#next"
      }
    ],
