        {
          "do": "press",
          "selector": "#cmd-4",
          "key": "Enter"
        },
        {
          "do": "expectText",
          "selector": "#log-4",
          "text": "^3$"
        },
        {
          "do": "expectText",
          "selector": "[data-step=\"4\"][data-pep-explore-feedback]",
          "text": "counted only uppercase ERROR"
        },
        {
          "do": "expectText",
          "selector": "#prog-text",
          "text": "^Activities done: 3 of 5"
        },
        {
          "do": "expectHidden",
          "selector": "#next"
        }
      ]
