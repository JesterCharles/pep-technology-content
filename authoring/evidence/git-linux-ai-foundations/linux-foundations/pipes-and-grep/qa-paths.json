        {
          "do": "click",
          "selector": "#next"
        },
        {
          "do": "fill",
          "selector": "#cmd-2",
          "value": "cat app.log | sort"
        },
        {
          "do": "press",
          "selector": "#cmd-2",
          "key": "Enter"
        },
        {
          "do": "expectText",
          "selector": "#log-2",
          "text": "sort: not available in this practice terminal"
        },
        {
          "do": "fill",
          "selector": "#cmd-2",
          "value": "grep -c ERROR app.log"
        },
        {
          "do": "press",
          "selector": "#cmd-2",
          "key": "Enter"
        },
        {
          "do": "expectText",
          "selector": "#log-2",
          "text": "grep -c: not available"
        },
        {
          "do": "fill",
          "selector": "#cmd-2",
          "value": "grep \"ERR.R\" app.log"
        },
        {
          "do": "press",
          "selector": "#cmd-2",
          "key": "Enter"
        },
        {
          "do": "expectText",
          "selector": "#log-2",
          "text": "special characters are not available"
        },
        {
          "do": "expectText",
          "selector": "#prog-text",
          "text": "^Activities done: 1 of 5"
        },
        {
          "do": "expectHidden",
          "selector": "#next"
        }
      ]
    },
    {
      "name": "look-alike grep without a pipe or with a file after the pipe earns no credit",
      "actions": [
        {
          "do": "check",
