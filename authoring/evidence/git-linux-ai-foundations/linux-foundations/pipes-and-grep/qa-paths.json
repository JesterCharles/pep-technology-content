        },
        {
          "do": "press",
          "selector": "#cmd-2",
          "key": "Enter"
        },
        {
          "do": "expectText",
          "selector": "[data-step=\"2\"][data-pep-explore-feedback]",
          "text": "this task practises the pipe"
        },
        {
          "do": "fill",
          "selector": "#cmd-2",
          "value": "grep ERROR"
        },
        {
          "do": "press",
          "selector": "#cmd-2",
          "key": "Enter"
        },
        {
          "do": "expectText",
          "selector": "#log-2",
          "text": "would wait for you to type input"
        },
        {
          "do": "fill",
          "selector": "#cmd-2",
          "value": "cat app.log | grep ERROR app.log"
        },
        {
          "do": "press",
          "selector": "#cmd-2",
          "key": "Enter"
        },
        {
          "do": "expectText",
          "selector": "#log-2",
          "text": "ignored the piped input"
        },
        {
          "do": "expectText",
          "selector": "#prog-text",
          "text": "^Activities done: 1 of 5"
        },
        {
          "do": "expectHidden",
          "selector": "#next"
        }
      ]
    },
    {
      "name": "case-sensitive count is a near miss",
      "actions": [
        {
          "do": "check",
          "selector": "input[name=predict][value=a]"
        },
        {
