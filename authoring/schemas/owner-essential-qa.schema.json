{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/authoring/schemas/owner-essential-qa.schema.json",
  "title": "PEP implementation-owner essential QA record (minimum acceptance profile)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "acceptanceProfile",
    "owner",
    "provenance",
    "independentCriticApproval",
    "statement",
    "checkedAt",
    "checks",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "acceptanceProfile": { "const": "minimum" },
    "owner": { "type": "string", "minLength": 1 },
    "provenance": { "type": "string", "minLength": 1 },
    "independentCriticApproval": { "const": "not-required-not-performed" },
    "statement": { "type": "string", "minLength": 1 },
    "checkedAt": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewedPath", "reviewedSha256"],
        "properties": {
          "reviewedPath": { "type": "string", "minLength": 1 },
          "reviewedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
