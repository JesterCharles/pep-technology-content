{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/authoring/schemas/track.schema.json",
  "title": "PEP track overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "track", "entry", "source", "days", "policy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "track": { "enum": ["foundation", "standard", "fast"] },
    "entry": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendarObjectSha256", "trackId"],
      "properties": {
        "calendarObjectSha256": { "$ref": "#/$defs/hash" },
        "trackId": { "type": "string", "minLength": 1 }
      }
    },
    "days": { "type": "array", "items": { "$ref": "#/$defs/day" } },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codingLabTime", "labAssessments", "requiredLabDays"],
      "properties": {
        "codingLabTime": { "enum": ["required", "not-required"] },
        "labAssessments": { "enum": ["required", "not-required"] },
        "requiredLabDays": { "enum": ["as-calendar", "required", "not-required"] }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ref": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+(?:/[a-z0-9-]+)?$" },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dayId",
        "dayType",
        "sourceStandardDays",
        "topics",
        "labs",
        "assessments",
        "external"
      ],
      "properties": {
        "dayId": { "type": "string", "minLength": 1 },
        "dayType": { "type": "string", "minLength": 1 },
        "sourceStandardDays": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "emphasis"],
            "properties": {
              "ref": { "$ref": "#/$defs/ref" },
              "emphasis": { "enum": ["full", "skim", "review"] }
            }
          }
        },
        "labs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "requirement"],
            "properties": {
              "ref": { "$ref": "#/$defs/ref" },
              "requirement": { "enum": ["required", "not-required"] }
            }
          }
        },
        "assessments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "external": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url", "kind"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "kind": { "const": "external-course" }
            }
          }
        }
      }
    }
  }
}
