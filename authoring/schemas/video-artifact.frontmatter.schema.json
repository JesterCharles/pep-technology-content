{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/authoring/schemas/video-artifact.frontmatter.schema.json",
  "title": "Video artifact front matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "channel",
    "url",
    "runtimeMinutes",
    "embeddable",
    "checkedAt",
    "covers",
    "gaps",
    "cautions",
    "alternates",
    "rejected"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "runtimeMinutes": { "type": "number", "exclusiveMinimum": 0 },
    "embeddable": { "type": "boolean" },
    "checkedAt": { "type": "string", "format": "date" },
    "covers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "cautions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "alternates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "rejected": {
      "type": "array",
      "items": { "allOf": [{ "$ref": "#/$defs/candidate" }, { "required": ["reason"] }] }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
