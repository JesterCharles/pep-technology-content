{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/authoring/schemas/assessment-blueprint.schema.json",
  "title": "Learner-safe assessment blueprint",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": { "$ref": "#/$defs/safeName" },
  "required": [
    "schemaVersion",
    "id",
    "dayId",
    "kind",
    "formats",
    "passMark",
    "weights",
    "objectives",
    "itemCounts",
    "durationMinutes",
    "allowedResources",
    "instructions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "dayId": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "formats": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "passMark": { "type": "number", "minimum": 0, "maximum": 100 },
    "weights": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/safeName" },
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*#o[1-9][0-9]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "objectiveFormats": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "itemCounts": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/safeName" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "durationMinutes": { "type": "integer", "minimum": 1 },
    "allowedResources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "instructions": { "type": "string", "minLength": 1 },
    "platformItemIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "safeName": {
      "not": {
        "pattern": "([Aa][Nn][Ss][Ww][Ee][Rr]|[Cc][Oo][Rr][Rr][Ee][Cc][Tt]|[Rr][Uu][Bb][Rr][Ii][Cc]|[Ss][Oo][Ll][Uu][Tt][Ii][Oo][Nn]|[Hh][Ii][Dd][Dd][Ee][Nn]|[Ss][Cc][Oo][Rr](?:[Ee]|[Ii][Nn][Gg])[-_ ]?(?:[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Gg][Uu][Ii][Dd][Ee]))"
      }
    }
  }
}
