{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/authoring/schemas/deferred-reviewable.schema.json",
  "title": "PEP module-scope deferral of pre-existing lab files outside a minimum-profile release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "acceptanceProfile",
    "status",
    "independentCriticApproval",
    "ownerReleaseApproval",
    "owner",
    "statement",
    "recordedAt",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "acceptanceProfile": { "const": "minimum" },
    "status": { "const": "deferred-excluded-not-counted" },
    "independentCriticApproval": { "const": "not-performed" },
    "ownerReleaseApproval": { "const": "not-granted" },
    "owner": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deferredPath", "deferredSha256", "reason"],
        "properties": {
          "deferredPath": { "type": "string", "pattern": "/coding-lab/(?:lab\\.json|README\\.md)$" },
          "deferredSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
