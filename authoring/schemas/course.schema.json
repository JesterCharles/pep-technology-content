{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/authoring/schemas/course.schema.json",
  "title": "PEP course manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "technologyId",
    "moduleOrder",
    "prerequisites",
    "curriculumSlice",
    "assessments",
    "courseLabs",
    "license",
    "owners"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1 },
    "technologyId": { "type": ["string", "integer"] },
    "moduleOrder": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "curriculumSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendarDayIds", "jsonPointers"],
      "properties": {
        "calendarDayIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "jsonPointers": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" },
          "uniqueItems": true
        }
      }
    },
    "assessments": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
    "courseLabs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "license": { "const": "proprietary-private" },
    "owners": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": { "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } }
}
