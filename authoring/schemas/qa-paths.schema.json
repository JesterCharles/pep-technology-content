{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/authoring/schemas/qa-paths.schema.json",
  "title": "PEP per-topic QA paths",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "completion",
    "progress",
    "routes",
    "simulatorEdges",
    "restart",
    "keyboard"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "completion": { "$ref": "#/$defs/assertion" },
    "progress": { "$ref": "#/$defs/assertion" },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "wrongFirst", "wrongTwice"],
      "properties": {
        "success": { "$ref": "#/$defs/actions" },
        "wrongFirst": { "$ref": "#/$defs/actions" },
        "wrongTwice": { "$ref": "#/$defs/actions" }
      }
    },
    "simulatorEdges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "actions"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "actions": { "$ref": "#/$defs/actions" }
        }
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "credit"],
      "properties": {
        "actions": { "$ref": "#/$defs/actions" },
        "credit": { "$ref": "#/$defs/assertion" }
      }
    },
    "keyboard": { "$ref": "#/$defs/actions" },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activityNavigation",
        "activityNavigationKeyboard",
        "activityNavigationTouch",
        "objectives",
        "objectivesTouch"
      ],
      "properties": {
        "activityNavigation": { "$ref": "#/$defs/actions" },
        "activityNavigationKeyboard": { "$ref": "#/$defs/actions" },
        "activityNavigationTouch": { "$ref": "#/$defs/actions" },
        "objectives": { "$ref": "#/$defs/actions" },
        "objectivesTouch": { "$ref": "#/$defs/actions" },
        "hints": {
          "oneOf": [
            { "$ref": "#/$defs/actions" },
            { "const": true }
          ]
        }
      }
    },
    "answerSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "privateSuccessProof": { "const": true },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/answerTask" }
        }
      }
    }
  },
  "$defs": {
    "answerTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "language", "targets"],
      "properties": {
        "task": { "type": "string", "pattern": "^#[A-Za-z][A-Za-z0-9_-]*$" },
        "language": {
          "enum": ["python-comprehension", "python-scaffold", "java", "sql", "javascript-editor", "jsx-editor"]
        },
        "scan": { "const": "none" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_]\\w*$" }
        },
        "targetMode": { "const": "statements" },
        "starter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "sha256"],
          "properties": {
            "target": { "type": "string", "pattern": "^[A-Za-z_]\\w*$" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "language": { "enum": ["python-scaffold", "sql", "javascript-editor", "jsx-editor"] } } },
          "then": { "required": ["scan"] },
          "else": { "not": { "required": ["scan"] } }
        },
        {
          "if": { "not": { "properties": { "language": { "const": "java" } } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["targetMode"] },
                { "required": ["starter"] }
              ]
            }
          }
        }
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "assertion": {
      "oneOf": [
        { "$ref": "#/$defs/textAssertion" },
        { "$ref": "#/$defs/valueAssertion" },
        { "$ref": "#/$defs/attributeAssertion" }
      ]
    },
    "textAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "text"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "valueAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "value"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "value": { "type": "string" }
      }
    },
    "attributeAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "attribute", "equals"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "attribute": { "type": "string", "minLength": 1 },
        "equals": { "type": "string" }
      }
    },
    "selector": { "type": "string", "minLength": 1 },
    "timeout": { "type": "integer", "minimum": 1, "maximum": 30000 },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["do"],
          "properties": { "do": { "enum": ["goBack", "goForward"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["do", "selector"],
          "properties": {
            "do": { "enum": ["click", "check", "expectVisible", "expectHidden", "expectEnabled", "expectDisabled", "expectFocus"] },
            "selector": { "$ref": "#/$defs/selector" },
            "timeoutMs": { "$ref": "#/$defs/timeout" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["do", "selector"],
          "properties": {
            "do": { "enum": ["fill", "select", "expectValue"] },
            "selector": { "$ref": "#/$defs/selector" },
            "value": { "type": "string" },
            "valueFrom": { "type": "string", "pattern": "^private:[A-Za-z0-9][A-Za-z0-9._-]*$" },
            "timeoutMs": { "$ref": "#/$defs/timeout" }
          },
          "oneOf": [
            { "required": ["value"] },
            { "required": ["valueFrom"] }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["do", "selector", "key"],
          "properties": {
            "do": { "const": "press" },
            "selector": { "$ref": "#/$defs/selector" },
            "key": { "type": "string", "minLength": 1 },
            "timeoutMs": { "$ref": "#/$defs/timeout" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["do", "selector", "text"],
          "properties": {
            "do": { "const": "expectText" },
            "selector": { "$ref": "#/$defs/selector" },
            "text": { "type": "string", "minLength": 1 },
            "timeoutMs": { "$ref": "#/$defs/timeout" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["do", "selector", "attribute", "equals"],
          "properties": {
            "do": { "const": "expectAttribute" },
            "selector": { "$ref": "#/$defs/selector" },
            "attribute": { "type": "string", "minLength": 1 },
            "equals": { "type": "string" },
            "timeoutMs": { "$ref": "#/$defs/timeout" }
          }
        }
      ]
    }
  }
}
