{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/authoring/schemas/qa-receipt.schema.json",
  "title": "PEP QA receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactHashes",
    "viewports",
    "checks",
    "passCount",
    "toolVersions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["width", "height"],
        "properties": {
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "theme": { "enum": ["light", "dark"] },
          "zoom": { "type": "number", "minimum": 0.1 }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail"] },
          "detail": { "type": "string" }
        }
      }
    },
    "passCount": { "type": "integer", "minimum": 0 },
    "toolVersions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "privateSuccessProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "commit", "runId", "ranAt", "environment", "result", "stagingRetired", "publicBindings"],
      "properties": {
        "record": { "type": "string", "pattern": "^validated at [a-f0-9]{40} by run [A-Za-z0-9._-]+$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "runId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "ranAt": { "type": "string", "format": "date-time" },
        "environment": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "result": { "const": "pass" },
        "stagingRetired": { "const": true },
        "publicBindings": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "reviewedSha256"],
            "properties": {
              "file": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
              "reviewedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}
