{
  "schemaVersion": 1,
  "completion": {
    "selector": "#lesson",
    "attribute": "data-pep-complete",
    "equals": "true"
  },
  "progress": { "selector": "#progress", "text": "^1 of 1$" },
  "routes": {
    "success": [
      { "do": "check", "selector": "#action-local" },
      { "do": "click", "selector": "#check-one" }
    ],
    "wrongFirst": [
      { "do": "check", "selector": "#action-external" },
      { "do": "click", "selector": "#check-one" },
      { "do": "expectText", "selector": "#feedback", "text": "Try again" },
      { "do": "check", "selector": "#action-local" },
      { "do": "click", "selector": "#check-one" }
    ],
    "wrongTwice": [
      { "do": "check", "selector": "#action-external" },
      { "do": "fill", "selector": "#activity-input", "value": "public boundary observation" },
      { "do": "click", "selector": "#check-one" },
      { "do": "click", "selector": "#check-one" },
      { "do": "click", "selector": "#next-activity" },
      { "do": "fill", "selector": "#activity-two-input", "value": "incomplete public explanation" },
      { "do": "check", "selector": "#activity-two-confirm" },
      { "do": "select", "selector": "#activity-two-scope", "value": "external" },
      { "do": "click", "selector": "#check-two" },
      { "do": "click", "selector": "#check-two" },
      { "do": "click", "selector": "#next-activity" },
      { "do": "fill", "selector": "#activity-three-input", "value": "incomplete public recap" },
      { "do": "click", "selector": "#check-three" },
      { "do": "click", "selector": "#check-three" },
      { "do": "expectText", "selector": "#activity-3 [data-pep-feedback]", "text": "settled, not correct" }
    ]
  },
  "simulatorEdges": [
    {
      "name": "unselected local-or-external choice remains incomplete",
      "actions": [
        { "do": "click", "selector": "#check-one" },
        { "do": "expectText", "selector": "#feedback", "text": "Choose where" },
        { "do": "expectAttribute", "selector": "#lesson", "attribute": "data-pep-complete", "equals": "false" }
      ]
    }
  ],
  "restart": {
    "actions": [
      { "do": "check", "selector": "#action-local" },
      { "do": "click", "selector": "#check-one" },
      { "do": "click", "selector": "#restart" },
      { "do": "check", "selector": "#action-local" },
      { "do": "click", "selector": "#check-one" }
    ],
    "credit": { "selector": "#progress", "text": "^1 of 1$" }
  },
  "guidance": {
    "activityNavigation": [
      { "do": "check", "selector": "#action-external" },
      { "do": "fill", "selector": "#activity-input", "value": "pointer note" },
      { "do": "click", "selector": "#check-one" },
      { "do": "click", "selector": "#check-one" },
      { "do": "click", "selector": "#next-activity" },
      { "do": "fill", "selector": "#activity-two-input", "value": "pointer explanation" },
      { "do": "check", "selector": "#activity-two-confirm" },
      { "do": "select", "selector": "#activity-two-scope", "value": "external" },
      { "do": "click", "selector": "#check-two" }
    ],
    "activityNavigationKeyboard": [
      { "do": "check", "selector": "#action-external" },
      { "do": "fill", "selector": "#activity-input", "value": "keyboard note" },
      { "do": "click", "selector": "#check-one" },
      { "do": "click", "selector": "#check-one" },
      { "do": "click", "selector": "#next-activity" },
      { "do": "fill", "selector": "#activity-two-input", "value": "keyboard explanation" },
      { "do": "check", "selector": "#activity-two-confirm" },
      { "do": "select", "selector": "#activity-two-scope", "value": "external" },
      { "do": "click", "selector": "#check-two" }
    ],
    "activityNavigationTouch": [
      { "do": "check", "selector": "#action-external" },
      { "do": "fill", "selector": "#activity-input", "value": "touch note" },
      { "do": "click", "selector": "#check-one" },
      { "do": "click", "selector": "#check-one" },
      { "do": "click", "selector": "#next-activity" },
      { "do": "fill", "selector": "#activity-two-input", "value": "touch explanation" },
      { "do": "check", "selector": "#activity-two-confirm" },
      { "do": "select", "selector": "#activity-two-scope", "value": "external" },
      { "do": "click", "selector": "#check-two" }
    ],
    "objectives": [
      { "do": "click", "selector": "[data-pep-objectives] > summary" },
      { "do": "expectVisible", "selector": "#objectives-body" },
      { "do": "press", "selector": "[data-pep-objectives] > summary", "key": "Escape" },
      { "do": "expectHidden", "selector": "#objectives-body" },
      { "do": "click", "selector": "[data-pep-objectives] > summary" },
      { "do": "click", "selector": "#page-title" },
      { "do": "expectHidden", "selector": "#objectives-body" }
    ],
    "objectivesTouch": [
      { "do": "click", "selector": "[data-pep-objectives] > summary" },
      { "do": "expectVisible", "selector": "#objectives-body" },
      { "do": "click", "selector": "#page-title" },
      { "do": "expectHidden", "selector": "#objectives-body" }
    ],
    "hints": [
      { "do": "click", "selector": "[data-pep-hint-order=\"1\"] > summary" },
      { "do": "expectVisible", "selector": "[data-pep-hint-order=\"1\"] > .pep-hint__body > [data-pep-hint-step]" },
      { "do": "click", "selector": "[data-pep-hint-order=\"2\"] > summary" },
      { "do": "expectVisible", "selector": "[data-pep-hint-order=\"2\"] > .pep-hint__body > [data-pep-hint-step]" }
    ]
  },
  "keyboard": [
    { "do": "check", "selector": "#action-local" },
    { "do": "click", "selector": "#check-one" }
  ]
}
