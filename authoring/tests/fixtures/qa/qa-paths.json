{
  "schemaVersion": 1,
  "completion": {
    "selector": "#lesson",
    "attribute": "data-pep-complete",
    "equals": "true"
  },
  "progress": { "selector": "#progress", "text": "^1 of 1$" },
  "routes": {
    "success": [
      { "do": "click", "selector": "#success" }
    ],
    "wrongFirst": [
      { "do": "click", "selector": "#wrong" },
      { "do": "expectText", "selector": "#feedback", "text": "Try again" },
      { "do": "click", "selector": "#retry-right" }
    ],
    "wrongTwice": [
      { "do": "click", "selector": "#wrong" },
      { "do": "click", "selector": "#retry-wrong" },
      { "do": "expectText", "selector": "#feedback", "text": "settled, not correct" }
    ]
  },
  "simulatorEdges": [
    {
      "name": "unsupported command",
      "actions": [
        { "do": "fill", "selector": "#command", "value": "unsupported" },
        { "do": "press", "selector": "#command", "key": "Enter" },
        { "do": "expectText", "selector": "#terminal-log", "text": "not available" }
      ]
    }
  ],
  "restart": {
    "actions": [
      { "do": "click", "selector": "#sim" },
      { "do": "click", "selector": "#restart" },
      { "do": "click", "selector": "#sim" }
    ],
    "credit": { "selector": "#progress", "text": "^1 of 1$" }
  },
  "guidance": {
    "activityNavigation": [
      { "do": "expectAttribute", "selector": "#timeline-a2", "attribute": "aria-disabled", "equals": "true" },
      { "do": "expectAttribute", "selector": "#timeline-a3", "attribute": "aria-disabled", "equals": "true" },
      { "do": "fill", "selector": "#activity-input", "value": "keep my first note" },
      { "do": "click", "selector": "#sim" },
      { "do": "click", "selector": "#next-activity" },
      { "do": "fill", "selector": "#activity-two-input", "value": "keep my explanation" },
      { "do": "expectAttribute", "selector": "#timeline-a3", "attribute": "aria-disabled", "equals": "true" },
      { "do": "click", "selector": "#previous-activity" },
      { "do": "expectFocus", "selector": "#activity-1-title" },
      { "do": "expectValue", "selector": "#activity-input", "value": "^keep my first note$" },
      { "do": "click", "selector": "#next-activity" },
      { "do": "expectFocus", "selector": "#activity-2-title" },
      { "do": "expectValue", "selector": "#activity-two-input", "value": "^keep my explanation$" },
      { "do": "click", "selector": "#complete-two" },
      { "do": "click", "selector": "#next-activity" },
      { "do": "goBack" },
      { "do": "expectVisible", "selector": "#activity-two-input" },
      { "do": "expectValue", "selector": "#activity-two-input", "value": "^keep my explanation$" },
      { "do": "goBack" },
      { "do": "expectVisible", "selector": "#activity-input" },
      { "do": "expectValue", "selector": "#activity-input", "value": "^keep my first note$" },
      { "do": "goForward" },
      { "do": "expectVisible", "selector": "#activity-two-input" },
      { "do": "click", "selector": "#restart" },
      { "do": "expectValue", "selector": "#activity-two-input", "value": "^$" },
      { "do": "click", "selector": "#previous-activity" },
      { "do": "expectValue", "selector": "#activity-input", "value": "^keep my first note$" }
    ],
    "activityNavigationKeyboard": [
      { "do": "fill", "selector": "#activity-input", "value": "keyboard note" },
      { "do": "click", "selector": "#sim" },
      { "do": "click", "selector": "#next-activity" },
      { "do": "expectFocus", "selector": "#activity-2-title" },
      { "do": "click", "selector": "#previous-activity" },
      { "do": "expectFocus", "selector": "#activity-1-title" },
      { "do": "expectValue", "selector": "#activity-input", "value": "^keyboard note$" }
    ],
    "activityNavigationTouch": [
      { "do": "fill", "selector": "#activity-input", "value": "touch note" },
      { "do": "click", "selector": "#sim" },
      { "do": "click", "selector": "#next-activity" },
      { "do": "click", "selector": "#previous-activity" },
      { "do": "expectValue", "selector": "#activity-input", "value": "^touch note$" }
    ],
    "objectives": [
      { "do": "click", "selector": "[data-pep-objectives] > summary" },
      { "do": "expectVisible", "selector": "#objectives-body" },
      { "do": "press", "selector": "[data-pep-objectives] > summary", "key": "Escape" },
      { "do": "expectHidden", "selector": "#objectives-body" },
      { "do": "click", "selector": "[data-pep-objectives] > summary" },
      { "do": "click", "selector": "#page-title" },
      { "do": "expectHidden", "selector": "#objectives-body" }
    ],
    "objectivesTouch": [
      { "do": "click", "selector": "[data-pep-objectives] > summary" },
      { "do": "expectVisible", "selector": "#objectives-body" },
      { "do": "click", "selector": "#page-title" },
      { "do": "expectHidden", "selector": "#objectives-body" }
    ],
    "hints": [
      { "do": "click", "selector": "[data-pep-hint-order=\"1\"] > summary" },
      { "do": "expectVisible", "selector": "[data-pep-hint-order=\"1\"] > .pep-hint__body > [data-pep-hint-step]" },
      { "do": "click", "selector": "[data-pep-hint-order=\"2\"] > summary" },
      { "do": "expectVisible", "selector": "[data-pep-hint-order=\"2\"] > .pep-hint__body > [data-pep-hint-step]" }
    ]
  },
  "keyboard": [
    { "do": "click", "selector": "#success" }
  ]
}
