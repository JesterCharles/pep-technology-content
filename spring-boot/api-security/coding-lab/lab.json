{
  "schemaVersion": 1,
  "id": "spring-boot/api-security/coding-lab",
  "scope": "module",
  "covers": [
    "spring-boot/api-security/session-cookies-vs-jwts-trade-offs",
    "spring-boot/api-security/password-hashing",
    "spring-boot/api-security/issuing-and-checking-a-jwt",
    "spring-boot/api-security/role-protected-endpoints",
    "spring-boot/api-security/a-dev-profile-that-keeps-endpoints-open-during-front-end-work",
    "spring-boot/api-security/common-api-security-risks-owasp"
  ],
  "objectives": [
    "spring-boot/api-security/password-hashing#o1",
    "spring-boot/api-security/password-hashing#o3",
    "spring-boot/api-security/issuing-and-checking-a-jwt#o1",
    "spring-boot/api-security/issuing-and-checking-a-jwt#o2",
    "spring-boot/api-security/issuing-and-checking-a-jwt#o3",
    "spring-boot/api-security/role-protected-endpoints#o1",
    "spring-boot/api-security/role-protected-endpoints#o2",
    "spring-boot/api-security/a-dev-profile-that-keeps-endpoints-open-during-front-end-work#o2"
  ],
  "language": "Java 25, Spring Boot 4.1.2",
  "prerequisites": [
    { "tool": "JDK", "version": "25", "check": "java -version" },
    { "tool": "Apache Maven", "version": "3.9 or later", "check": "mvn -v" }
  ],
  "os": ["macos", "linux", "windows"],
  "network": { "setup": "once", "test": "none" },
  "setup": { "command": "mvn -q dependency:go-offline", "cwd": "starter" },
  "test": {
    "command": "mvn -q -o test",
    "cwd": "starter",
    "timeoutSeconds": 600,
    "starterExpectation": "fail",
    "failingTests": [
      "secure.SecurityLabTest.task1StoresOnlyHashedPasswords",
      "secure.SecurityLabTest.task2ProtectsEndpointsByPathAndRole",
      "secure.SecurityLabTest.task3IssuesASignedTokenWithClaimsAndExpiry",
      "secure.SecurityLabTest.task4AcceptsItsOwnTokensAndRejectsTampering",
      "secure.DevProfileSecurityTest.task5DevProfileKeepsEndpointsOpen"
    ]
  },
  "fixtures": { "seed": 0, "files": [] },
  "expectedOutput": "expected/test-summary.txt",
  "cleanup": {
    "paths": ["starter/target"],
    "notes": "Delete starter/target to remove compiled classes and test reports. No port, database or on-disk state is used by the tests. Setup reuses the Spring Boot 4.1.2 artifacts already cached by the earlier Spring labs in the learner's local Maven repository (~/.m2/repository by default); the cache is not removed by cleanup."
  },
  "minutes": { "setup": 5, "tasks": 35 },
  "trackRequirement": { "standard": "required", "fast": "not-required" },
  "platform": { "handoff": "bundle", "adapter": null },
  "licensing": [
    "Starter, tests and README: original work for this repository.",
    "Spring Boot 4.1.2, Spring Security, Nimbus JOSE+JWT (Apache License 2.0), JUnit (EPL 2.0) and Apache Maven plugins (Apache License 2.0) are downloaded by Maven at setup; none is committed.",
    "All credential values in this lab (admin-dev-password, the jwt.secret default) are deliberately fake development values, not real secrets."
  ]
}
