{
  "schemaVersion": 1,
  "id": "spring-boot/integration-and-observability/coding-lab",
  "scope": "module",
  "covers": [
    "spring-boot/integration-and-observability/an-integration-test",
    "spring-boot/integration-and-observability/calling-another-service-with-restclient-base-url-and-timeouts",
    "spring-boot/integration-and-observability/logging-in-spring",
    "spring-boot/integration-and-observability/health-checks"
  ],
  "objectives": [
    "spring-boot/integration-and-observability/an-integration-test#o1",
    "spring-boot/integration-and-observability/an-integration-test#o2",
    "spring-boot/integration-and-observability/calling-another-service-with-restclient-base-url-and-timeouts#o1",
    "spring-boot/integration-and-observability/calling-another-service-with-restclient-base-url-and-timeouts#o2",
    "spring-boot/integration-and-observability/calling-another-service-with-restclient-base-url-and-timeouts#o3",
    "spring-boot/integration-and-observability/logging-in-spring#o1",
    "spring-boot/integration-and-observability/health-checks#o1"
  ],
  "language": "Java 25, Spring Boot 4.1.2",
  "prerequisites": [
    { "tool": "JDK", "version": "25", "check": "java -version" },
    { "tool": "Apache Maven", "version": "3.9 or later", "check": "mvn -v" }
  ],
  "os": ["macos", "linux", "windows"],
  "network": { "setup": "once", "test": "none" },
  "setup": { "command": "mvn -q dependency:go-offline", "cwd": "starter" },
  "test": {
    "command": "mvn -q -o test",
    "cwd": "starter",
    "timeoutSeconds": 600,
    "starterExpectation": "fail",
    "failingTests": [
      "ops.OpsIntegrationTest.task1BootsTheFullContextAndPingsIt",
      "ops.PartnerClientTest.task2CallsThePartnerStatusEndpoint",
      "ops.PartnerClientTest.task3TurnsAPartnerFailureIntoUnknownAndALogLine",
      "ops.HealthEndpointTest.task4ContributesPartnerHealthWithDetails"
    ]
  },
  "fixtures": { "seed": 0, "files": [] },
  "expectedOutput": "expected/test-summary.txt",
  "cleanup": {
    "paths": ["starter/target"],
    "notes": "Delete starter/target to remove compiled classes and test reports. The partner URL is intercepted in the JVM; no network listener or on-disk state is created. Setup reuses the Spring Boot 4.1.2 artifacts already cached by the earlier Spring labs in the learner's local Maven repository (~/.m2/repository by default); the cache is not removed by cleanup."
  },
  "minutes": { "setup": 5, "tasks": 25 },
  "trackRequirement": { "standard": "not-required", "fast": "not-required" },
  "platform": { "handoff": "bundle", "adapter": null },
  "licensing": [
    "Starter, tests and README: original work for this repository.",
    "Spring Boot 4.1.2, Spring Boot Actuator, Micrometer (Apache License 2.0), JUnit (EPL 2.0) and Apache Maven plugins (Apache License 2.0) are downloaded by Maven at setup; none is committed."
  ]
}
