{
  "schemaVersion": 1,
  "id": "spring-boot/porting-and-configuration/coding-lab",
  "scope": "module",
  "covers": [
    "spring-boot/porting-and-configuration/porting-a-javalin-route-service-and-repository-to-spring-boot",
    "spring-boot/porting-and-configuration/constructor-injection-across-layers",
    "spring-boot/porting-and-configuration/rest-design-recap",
    "spring-boot/porting-and-configuration/configuration-files-and-profiles",
    "spring-boot/porting-and-configuration/secrets-from-the-environment",
    "spring-boot/porting-and-configuration/schema-migrations-with-flyway"
  ],
  "objectives": [
    "spring-boot/porting-and-configuration/porting-a-javalin-route-service-and-repository-to-spring-boot#o1",
    "spring-boot/porting-and-configuration/porting-a-javalin-route-service-and-repository-to-spring-boot#o2",
    "spring-boot/porting-and-configuration/constructor-injection-across-layers#o1",
    "spring-boot/porting-and-configuration/configuration-files-and-profiles#o1",
    "spring-boot/porting-and-configuration/configuration-files-and-profiles#o2",
    "spring-boot/porting-and-configuration/secrets-from-the-environment#o1",
    "spring-boot/porting-and-configuration/secrets-from-the-environment#o2",
    "spring-boot/porting-and-configuration/schema-migrations-with-flyway#o1"
  ],
  "language": "Java 25, Spring Boot 4.1.2",
  "prerequisites": [
    { "tool": "JDK", "version": "25", "check": "java -version" },
    { "tool": "Apache Maven", "version": "3.9 or later", "check": "mvn -v" }
  ],
  "os": ["macos", "linux", "windows"],
  "network": { "setup": "once", "test": "none" },
  "setup": { "command": "mvn -q dependency:go-offline", "cwd": "starter" },
  "test": {
    "command": "mvn -q -o test",
    "cwd": "starter",
    "timeoutSeconds": 600,
    "starterExpectation": "fail",
    "failingTests": [
      "catalog.ItemApiTest.task1ListsTheCatalogItems",
      "catalog.ItemApiTest.task2PortsTheDetailRouteAndIts404",
      "catalog.ItemApiTest.task3CapsTheListingAtThePageSize",
      "catalog.DemoProfileTest.task4DemoProfileOverridesTheGreeting",
      "catalog.ItemApiTest.task5ReadsTheAdminTokenFromTheEnvironment",
      "catalog.MigrationTest.task6SeedsTheCatalogItemsTable"
    ]
  },
  "fixtures": { "seed": 0, "files": [] },
  "expectedOutput": "expected/test-summary.txt",
  "cleanup": {
    "paths": ["starter/target"],
    "notes": "Delete starter/target to remove compiled classes and test reports. The H2 database is in-memory and leaves nothing on disk. Setup downloads Spring Boot 4.1.2, Flyway and H2 into the learner's local Maven repository (~/.m2/repository by default); that shared cache is kept for the other Spring labs and is not removed by cleanup."
  },
  "minutes": { "setup": 5, "tasks": 25 },
  "trackRequirement": { "standard": "not-required", "fast": "not-required" },
  "platform": { "handoff": "bundle", "adapter": null },
  "licensing": [
    "Starter, tests and README: original work for this repository.",
    "Spring Boot 4.1.2, Flyway and H2 (Apache License 2.0 / EPL 1.0 for H2's MPL 2.0/EPL 1.0 dual license), JUnit (EPL 2.0) and Apache Maven plugins (Apache License 2.0) are downloaded by Maven at setup; none is committed.",
    "The committed token value 'letmein' and the test value 'test-only-token' are deliberately fake teaching values, not real secrets."
  ]
}
