{
  "schemaVersion": 1,
  "id": "spring-boot/spring-boot-basics/coding-lab",
  "scope": "module",
  "covers": [
    "spring-boot/spring-boot-basics/dependency-injection-replacing-manual-wiring",
    "spring-boot/spring-boot-basics/beans-and-bean-scopes",
    "spring-boot/spring-boot-basics/rest-controllers",
    "spring-boot/spring-boot-basics/path-query-and-body-parameters",
    "spring-boot/spring-boot-basics/response-codes-with-responseentity"
  ],
  "objectives": [
    "spring-boot/spring-boot-basics/dependency-injection-replacing-manual-wiring#o1",
    "spring-boot/spring-boot-basics/rest-controllers#o1",
    "spring-boot/spring-boot-basics/path-query-and-body-parameters#o1",
    "spring-boot/spring-boot-basics/response-codes-with-responseentity#o1"
  ],
  "language": "Java 25, Spring Boot 4.1.2",
  "prerequisites": [
    { "tool": "JDK", "version": "25", "check": "java -version" },
    { "tool": "Apache Maven", "version": "3.9 or later", "check": "mvn -v" }
  ],
  "os": ["macos", "linux", "windows"],
  "network": { "setup": "once", "test": "none" },
  "setup": { "command": "mvn -q dependency:go-offline", "cwd": "starter" },
  "test": {
    "command": "mvn -q -o test",
    "cwd": "starter",
    "timeoutSeconds": 600,
    "starterExpectation": "fail",
    "failingTests": [
      "workshops.WorkshopApiTest.task1ListsTheSeededWorkshops",
      "workshops.WorkshopApiTest.task2FindsOneWorkshopByItsId",
      "workshops.WorkshopApiTest.task3UnknownWorkshopIdGives404",
      "workshops.WorkshopApiTest.task4FiltersWorkshopsByMinSeats",
      "workshops.WorkshopApiTest.task5CreateReturns201AndTheCreatedWorkshop"
    ]
  },
  "fixtures": { "seed": 0, "files": [] },
  "expectedOutput": "expected/test-summary.txt",
  "cleanup": {
    "paths": ["starter/target"],
    "notes": "Delete starter/target to remove compiled classes and test reports. Setup downloads Spring Boot 4.1.2 and the pinned plugins into the learner's local Maven repository (~/.m2/repository by default); that shared cache is kept for the other Spring labs and is not removed by cleanup."
  },
  "minutes": { "setup": 8, "tasks": 22 },
  "trackRequirement": { "standard": "not-required", "fast": "not-required" },
  "platform": { "handoff": "bundle", "adapter": null },
  "licensing": [
    "Starter, tests and README: original work for this repository.",
    "Spring Boot 4.1.2 and its dependencies (Apache License 2.0), JUnit (EPL 2.0) and Apache Maven plugins (Apache License 2.0) are downloaded by Maven at setup; none is committed."
  ]
}
