{
  "schemaVersion": 1,
  "id": "spring-boot/validation-errors-and-testing/coding-lab",
  "scope": "module",
  "covers": [
    "spring-boot/validation-errors-and-testing/bean-validation-on-requests",
    "spring-boot/validation-errors-and-testing/global-error-handling",
    "spring-boot/validation-errors-and-testing/standard-error-responses-with-problemdetail",
    "spring-boot/validation-errors-and-testing/mockito-in-spring-at-mockitobean",
    "spring-boot/validation-errors-and-testing/web-layer-tests-with-mockmvc",
    "spring-boot/validation-errors-and-testing/debugging-a-failing-request"
  ],
  "objectives": [
    "spring-boot/validation-errors-and-testing/bean-validation-on-requests#o1",
    "spring-boot/validation-errors-and-testing/bean-validation-on-requests#o2",
    "spring-boot/validation-errors-and-testing/global-error-handling#o1",
    "spring-boot/validation-errors-and-testing/global-error-handling#o3",
    "spring-boot/validation-errors-and-testing/standard-error-responses-with-problemdetail#o1",
    "spring-boot/validation-errors-and-testing/mockito-in-spring-at-mockitobean#o1",
    "spring-boot/validation-errors-and-testing/web-layer-tests-with-mockmvc#o1"
  ],
  "language": "Java 25, Spring Boot 4.1.2",
  "prerequisites": [
    { "tool": "JDK", "version": "25", "check": "java -version" },
    { "tool": "Apache Maven", "version": "3.9 or later", "check": "mvn -v" }
  ],
  "os": ["macos", "linux", "windows"],
  "network": { "setup": "once", "test": "none" },
  "setup": { "command": "mvn -q dependency:go-offline", "cwd": "starter" },
  "test": {
    "command": "mvn -q -o test",
    "cwd": "starter",
    "timeoutSeconds": 600,
    "starterExpectation": "fail",
    "failingTests": [
      "bookings.ValidationApiTest.task1RejectsAnInvalidBookingWith400",
      "bookings.ValidationApiTest.task2TurnsAnUnknownIdIntoAProblem404",
      "bookings.ValidationApiTest.task3AnswersValidationFailuresWithProblemDetail",
      "bookings.WebLayerTest.task4StubsTheServiceWithMockitoBean"
    ]
  },
  "fixtures": { "seed": 0, "files": [] },
  "expectedOutput": "expected/test-summary.txt",
  "cleanup": {
    "paths": ["starter/target"],
    "notes": "Delete starter/target to remove compiled classes and test reports. Setup reuses the Spring Boot 4.1.2 artifacts already cached by the earlier Spring labs in the learner's local Maven repository (~/.m2/repository by default); the cache is not removed by cleanup."
  },
  "minutes": { "setup": 5, "tasks": 25 },
  "trackRequirement": { "standard": "required", "fast": "not-required" },
  "platform": { "handoff": "bundle", "adapter": null },
  "licensing": [
    "Starter, tests and README: original work for this repository.",
    "Spring Boot 4.1.2, Hibernate Validator (Apache License 2.0), Mockito (MIT), JUnit (EPL 2.0) and Apache Maven plugins (Apache License 2.0) are downloaded by Maven at setup; none is committed."
  ]
}
