    "command": "mvn -q -o test",
    "cwd": "starter",
    "timeoutSeconds": 600,
    "starterExpectation": "fail",
    "failingTests": [
      "bookings.RelationshipApiTest.task1MapsTheRelationshipAndServesASession",
      "bookings.RelationshipApiTest.task2RollsBackTheFailedBooking",
      "bookings.RelationshipApiTest.task3LoadsTheSummariesWithoutNPlusOne",
      "bookings.RelationshipApiTest.task4ServesLazySessionsFromAReadOnlyTransaction"
    ]
  },
  "fixtures": { "seed": 0, "files": ["starter/src/main/resources/data.sql"] },
  "expectedOutput": "expected/test-summary.txt",
  "cleanup": {
    "paths": ["starter/target"],
    "notes": "Delete starter/target to remove compiled classes and test reports. The H2 database is in-memory and leaves nothing on disk. Setup reuses the Spring Boot 4.1.2 artifacts already cached by the earlier Spring labs in the learner's local Maven repository (~/.m2/repository by default); the cache is not removed by cleanup."
