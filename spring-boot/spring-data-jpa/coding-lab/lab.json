{
  "schemaVersion": 1,
  "id": "spring-boot/spring-data-jpa/coding-lab",
  "scope": "module",
  "covers": [
    "spring-boot/spring-data-jpa/spring-data-jpa-with-hibernate",
    "spring-boot/spring-data-jpa/entities-and-ids",
    "spring-boot/spring-data-jpa/repositories-derived-queries-and-at-query",
    "spring-boot/spring-data-jpa/seeing-the-generated-sql",
    "spring-boot/spring-data-jpa/controller-service-and-repository-layers",
    "spring-boot/spring-data-jpa/dtos-and-mapping",
    "spring-boot/spring-data-jpa/pagination-and-sorting"
  ],
  "objectives": [
    "spring-boot/spring-data-jpa/entities-and-ids#o1",
    "spring-boot/spring-data-jpa/repositories-derived-queries-and-at-query#o1",
    "spring-boot/spring-data-jpa/repositories-derived-queries-and-at-query#o2",
    "spring-boot/spring-data-jpa/repositories-derived-queries-and-at-query#o3",
    "spring-boot/spring-data-jpa/pagination-and-sorting#o1",
    "spring-boot/spring-data-jpa/pagination-and-sorting#o3",
    "spring-boot/spring-data-jpa/dtos-and-mapping#o1",
    "spring-boot/spring-data-jpa/dtos-and-mapping#o2"
  ],
  "language": "Java 25, Spring Boot 4.1.2",
  "prerequisites": [
    { "tool": "JDK", "version": "25", "check": "java -version" },
    { "tool": "Apache Maven", "version": "3.9 or later", "check": "mvn -v" }
  ],
  "os": ["macos", "linux", "windows"],
  "network": { "setup": "once", "test": "none" },
  "setup": { "command": "mvn -q dependency:go-offline", "cwd": "starter" },
  "test": {
    "command": "mvn -q -o test",
    "cwd": "starter",
    "timeoutSeconds": 600,
    "starterExpectation": "fail",
    "failingTests": [
      "workshops.WorkshopJpaApiTest.task1MapsTheEntityAndListsTheSeededRows",
      "workshops.WorkshopJpaApiTest.task2DerivedQueryFiltersByCategorySortedByTitle",
      "workshops.WorkshopJpaApiTest.task3JpqlSearchMatchesAnyCase",
      "workshops.WorkshopJpaApiTest.task4PagesAndSortsWithStableJsonShape",
      "workshops.WorkshopJpaApiTest.task5ResponsesExposeOnlyTheDtoFields"
    ]
  },
  "fixtures": { "seed": 0, "files": ["starter/src/main/resources/data.sql"] },
  "expectedOutput": "expected/test-summary.txt",
  "cleanup": {
    "paths": ["starter/target"],
    "notes": "Delete starter/target to remove compiled classes and test reports. The H2 database is in-memory and leaves nothing on disk. Setup downloads Spring Boot 4.1.2, Spring Data JPA, Hibernate and H2 into the learner's local Maven repository (~/.m2/repository by default); that shared cache is kept for the other Spring labs and is not removed by cleanup."
  },
  "minutes": { "setup": 5, "tasks": 35 },
  "trackRequirement": { "standard": "not-required", "fast": "not-required" },
  "platform": { "handoff": "bundle", "adapter": null },
  "licensing": [
    "Starter, tests, data.sql and README: original work for this repository.",
    "Spring Boot 4.1.2, Spring Data JPA and Hibernate ORM 7 (Apache License 2.0), H2 (MPL 2.0/EPL 1.0), JUnit (EPL 2.0) and Apache Maven plugins (Apache License 2.0) are downloaded by Maven at setup; none is committed."
  ]
}
