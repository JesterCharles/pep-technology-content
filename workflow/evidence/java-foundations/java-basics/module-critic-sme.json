  "findings": [
    {
      "id": "java-basics-sme-003",
      "severity": "high",
      "location": {
        "file": "foundational-track/java-foundations/java-basics/coding-lab/tests/basics/BasicsTest.java",
        "line": 36
      },
      "claim": "The public tests do not substantiate README.md lines 45 and 73 that a passing submission uses each named idea. Five checks search for tokens anywhere in the whole source and all output checks use one fixed input; a program with hard-coded results, dead branches, and tokens inside unused strings passes all six tests without using the required variables, remainder, switch, or loop.",
      "evidence": [],
      "recommendation": "Refactor the starter into small input-parameterized methods and test multiple inputs and edge cases. For objectives that require a specific construct, inspect the relevant method structurally (or weaken the README claim); do not accept whole-file substring presence as proof.",
      "reviewedSha256": "5a542dd4c143bc6854db7e955233272ec941e4622d235e35641ae2b634b4aa24"
    },
    {
      "id": "java-basics-sme-001",
      "severity": "medium",
      "location": {
        "file": "foundational-track/java-foundations/java-basics/strings-and-string-methods/artifact.html",
        "line": 214
      },
      "claim": "The page presents String.length() as a character count and charAt() as returning a character without stating that Java indexes UTF-16 char values (code units). For supplementary Unicode characters, length() can be 2 and charAt() returns one surrogate, so the unqualified objective and cheat sheet are technically false.",
      "evidence": [
        {
          "url": "https://docs.oracle.com/en/java/javase/25/docs/api/java.base/java/lang/String.html",
          "section": "Class description; length(); charAt(int); codePointAt(int)",
          "retrievedAt": "2026-10-13T18:02:44Z",
          "textSha256": "d6fe54ea59fc2c32b57df32f03ec3af06d0c95043fb1c284d7d30a890b5729e2"
        }
      ],
      "recommendation": "Scope the current statements explicitly to the ASCII examples, and add one concise accuracy note that String indexes and length count UTF-16 char values; charAt returns one char value and code-point APIs are needed for general Unicode text.",
      "reviewedSha256": "5930cba8178219d767828ec4d4b489f0dccc1d6df3e6bb52beb97164076ae100"
    },
    {
      "id": "java-basics-sme-002",
      "severity": "low",
      "location": {
        "file": "foundational-track/java-foundations/java-basics/arithmetic-comparison-and-logical-operators/artifact.html",
        "line": 228
      },
      "claim": "The page says compound assignment x op= e \u201cmeans\u201d x = x op (e). Java compound assignment also performs an implicit cast to the left-hand type and evaluates the left operand only once, so the equivalence is only safe for the shown simple int examples.",
      "evidence": [
        {
          "url": "https://docs.oracle.com/javase/specs/jls/se25/html/jls-15.html",
          "section": "JLS 15.26.2 Compound Assignment Operators",
          "retrievedAt": "2026-10-13T18:02:45Z",
          "textSha256": "829701f2d3efe55e03598155b2be2a2e19e9b3a0f1e9ca5c2401b616a8baae19"
        }
      ],
      "recommendation": "Qualify the shorthand as applying to these simple int examples, or state the JLS-equivalent form with the implicit cast and note that the left side is evaluated once.",
      "reviewedSha256": "ee9254aeec996941bbb16f9934c73510a9a5cffa7b00b145feafd57c30a757f8"
    }
  ]
