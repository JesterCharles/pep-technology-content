{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/workflow/schemas/module-lock.schema.json",
  "title": "Generated PEP module lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "course", "module", "files", "evidenceBindings"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "course": { "$ref": "#/$defs/slug" },
    "module": { "$ref": "#/$defs/slug" },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "evidenceBindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidencePath", "field", "artifactPath", "sha256", "current"],
      "properties": {
        "topic": { "$ref": "#/$defs/slug" },
        "evidencePath": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "artifactPath": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "current": { "type": "boolean" },
        "historical": { "const": true },
        "missing": { "const": true }
      },
      "allOf": [
        {
          "if": { "required": ["missing"] },
          "then": {
            "required": ["historical"],
            "properties": { "current": { "const": false } }
          }
        }
      ]
    }
  }
}
