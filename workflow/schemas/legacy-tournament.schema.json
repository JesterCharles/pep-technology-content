{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/workflow/schemas/legacy-tournament.schema.json",
  "title": "Frozen tournament preservation index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventManifest",
    "hashIndex",
    "preservedTarball",
    "cancellationDate"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "status": { "const": "frozen-preflight-not-launched" }
      }
    },
    "hashIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "preservedTarball": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256SumsPath", "sha256SumsContents"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256SumsPath": { "type": "string", "pattern": "^/" },
        "sha256SumsContents": { "type": "string", "minLength": 1 }
      }
    },
    "cancellationDate": { "const": "2026-10-08" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
