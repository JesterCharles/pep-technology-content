{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/workflow/schemas/curriculum-lock.schema.json",
  "title": "PEP curriculum snapshot lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "curriculumVersion", "extractionToolVersion", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "curriculumVersion": { "type": "string", "minLength": 1 },
    "extractionToolVersion": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
