{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/schemas/qa-receipt.schema.json",
  "title": "PEP QA receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactHashes",
    "viewports",
    "checks",
    "passCount",
    "toolVersions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["width", "height"],
        "properties": {
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "theme": { "enum": ["light", "dark"] },
          "zoom": { "type": "number", "minimum": 0.1 }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail"] },
          "detail": { "type": "string" }
        }
      }
    },
    "passCount": { "type": "integer", "minimum": 0 },
    "toolVersions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
