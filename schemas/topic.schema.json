{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://pep.local/schemas/topic.schema.json","title":"PEP topic manifest","type":"object","additionalProperties":false,
  "required":["schemaVersion","id","title","kind","curriculum","objectives","prerequisites","minutes","artifacts","freshness","licensing","lab","components"],
  "properties":{
    "schemaVersion":{"const":1},"id":{"$ref":"#/$defs/slug"},"title":{"type":"string","minLength":1},"kind":{"enum":["core","reading","review","lab-brief"]},
    "curriculum":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["pointer","calendarDayIds","relation"],"properties":{"pointer":{"type":"string","pattern":"^/"},"calendarDayIds":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},"relation":{"enum":["exact","split","shared"]}}}},
    "objectives":{"type":"array","minItems":0,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["id","text"],"properties":{"id":{"type":"string","pattern":"^o[1-9][0-9]*$"},"text":{"type":"string","minLength":1}}}},
    "prerequisites":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "minutes":{"type":"object","additionalProperties":false,"required":["aboutLabel","budget","modeledP50","modeledWorstPath","basis"],"properties":{"aboutLabel":{"type":"integer","minimum":0,"maximum":15},"budget":{"type":"integer","minimum":0,"maximum":15},"modeledP50":{"type":"number","minimum":0},"modeledWorstPath":{"type":"number","minimum":0},"basis":{"type":"string","minLength":1}}},
    "artifacts":{"type":"object","additionalProperties":false,"required":["html","md","pdf","gift","video","lab"],"properties":{"html":{"$ref":"#/$defs/artifact"},"md":{"$ref":"#/$defs/artifact"},"pdf":{"$ref":"#/$defs/artifact"},"gift":{"$ref":"#/$defs/artifact"},"video":{"$ref":"#/$defs/artifact"},"lab":{"$ref":"#/$defs/artifact"}}},
    "freshness":{"type":"object","additionalProperties":false,"required":["status","checkedAt","sourcesRef","unverifiedItems"],"properties":{"status":{"enum":["verified","partially-verified","unverified"]},"checkedAt":{"anyOf":[{"type":"string","format":"date"},{"type":"null"}]},"sourcesRef":{"type":"string","minLength":1},"unverifiedItems":{"type":"array","items":{"type":"string","minLength":1}}}},
    "licensing":{"type":"array","items":{"type":"object","required":["item","license","source"],"properties":{"item":{"type":"string","minLength":1},"license":{"type":"string","minLength":1},"source":{"type":"string","minLength":1}},"additionalProperties":true}},
    "lab":{"type":"string","pattern":"^(none|topic|module:[a-z0-9]+(?:-[a-z0-9]+)*|course:[a-z0-9]+(?:-[a-z0-9]+)*)$"},
    "components":{"type":"object","propertyNames":{"$ref":"#/$defs/slug"},"additionalProperties":{"type":"string","minLength":1}}
  },
  "$defs":{"slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"artifact":{"oneOf":[{"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"const":"present"}}},{"type":"object","additionalProperties":false,"required":["status","reason"],"properties":{"status":{"const":"absent"},"reason":{"type":"string","minLength":1}}}]}}
}
