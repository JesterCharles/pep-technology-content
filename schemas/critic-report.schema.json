{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/schemas/critic-report.schema.json",
  "title": "Independent critic report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "role", "author", "reviewedSha256", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "role": { "enum": ["education", "sme"] },
    "author": { "type": "string", "minLength": 1 },
    "reviewedSha256": { "$ref": "#/$defs/hash" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "location",
        "claim",
        "evidence",
        "recommendation",
        "reviewedSha256"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "selector": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 }
          },
          "oneOf": [{ "required": ["selector"] }, { "required": ["line"] }]
        },
        "claim": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "section", "retrievedAt", "textSha256"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "section": { "type": "string", "minLength": 1 },
              "retrievedAt": { "type": "string", "format": "date-time" },
              "textSha256": { "$ref": "#/$defs/hash" }
            }
          }
        },
        "recommendation": { "type": "string", "minLength": 1 },
        "reviewedSha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
