{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://pep.local/schemas/module.schema.json","title":"PEP module manifest","type":"object","additionalProperties":false,
  "required":["schemaVersion","id","title","description","topicOrder","moduleLabs","assessments","sourceCoverageNotes"],
  "properties":{
    "schemaVersion":{"const":1},"id":{"$ref":"#/$defs/slug"},"title":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},
    "topicOrder":{"type":"array","items":{"$ref":"#/$defs/slug"},"uniqueItems":true},
    "moduleLabs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "assessments":{"type":"array","items":{"$ref":"#/$defs/slug"},"uniqueItems":true},
    "sourceCoverageNotes":{"type":"array","items":{"type":"string","minLength":1}}
  },"$defs":{"slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
}
