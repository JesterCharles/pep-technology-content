{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://pep.local/schemas/lab.schema.json","title":"PEP coding lab","type":"object","additionalProperties":false,"propertyNames":{"$ref":"#/$defs/safeName"},
  "required":["schemaVersion","id","scope","covers","objectives","language","prerequisites","os","network","setup","test","fixtures","expectedOutput","cleanup","minutes","trackRequirement","platform","licensing"],
  "properties":{
    "schemaVersion":{"const":1},"id":{"type":"string","pattern":"^[a-z0-9-]+(?:/[a-z0-9-]+)+/coding-lab$"},"scope":{"enum":["topic","module","course"]},"covers":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$"},"uniqueItems":true},"objectives":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+#o[1-9][0-9]*$"},"uniqueItems":true},"language":{"type":"string","minLength":1},
    "prerequisites":{"type":"array","items":{"type":"object","propertyNames":{"$ref":"#/$defs/safeName"},"additionalProperties":false,"required":["tool","version","check"],"properties":{"tool":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"check":{"type":"string","minLength":1}}}},
    "os":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["macos","linux","windows"]}},"network":{"type":"object","propertyNames":{"$ref":"#/$defs/safeName"},"additionalProperties":false,"required":["setup","test"],"properties":{"setup":{"enum":["once","none"]},"test":{"const":"none"}}},
    "setup":{"type":"object","propertyNames":{"$ref":"#/$defs/safeName"},"additionalProperties":false,"required":["command","cwd"],"properties":{"command":{"type":"string","minLength":1},"cwd":{"type":"string","minLength":1}}},
    "test":{"type":"object","propertyNames":{"$ref":"#/$defs/safeName"},"additionalProperties":false,"required":["command","cwd","timeoutSeconds","starterExpectation","failingTests"],"properties":{"command":{"type":"string","minLength":1},"cwd":{"type":"string","minLength":1},"timeoutSeconds":{"type":"integer","minimum":1},"starterExpectation":{"enum":["fail","pass-exploratory"]},"failingTests":{"type":"array","items":{"type":"string","minLength":1}}}},
    "fixtures":{"type":"object","propertyNames":{"$ref":"#/$defs/safeName"},"additionalProperties":false,"required":["seed","files"],"properties":{"seed":{"type":"integer"},"files":{"type":"array","items":{"type":"string","minLength":1}}}},"expectedOutput":{"type":"string","minLength":1},
    "cleanup":{"type":"object","propertyNames":{"$ref":"#/$defs/safeName"},"additionalProperties":false,"required":["paths","notes"],"properties":{"paths":{"type":"array","items":{"type":"string","minLength":1}},"notes":{"type":"string","minLength":1}}},
    "minutes":{"type":"object","propertyNames":{"$ref":"#/$defs/safeName"},"minProperties":1,"additionalProperties":{"type":"integer","minimum":1}},"trackRequirement":{"type":"object","propertyNames":{"$ref":"#/$defs/safeName"},"additionalProperties":{"enum":["required","not-required"]}},
    "platform":{"type":"object","propertyNames":{"$ref":"#/$defs/safeName"},"additionalProperties":false,"required":["handoff","adapter"],"properties":{"handoff":{"const":"bundle"},"adapter":{"type":["string","null"]}}},
    "licensing":{"type":"array","items":{"$ref":"#/$defs/safeValue"}}
  },
  "$defs":{"safeName":{"not":{"pattern":"([Aa][Nn][Ss][Ww][Ee][Rr]|[Cc][Oo][Rr][Rr][Ee][Cc][Tt]|[Rr][Uu][Bb][Rr][Ii][Cc]|[Ss][Oo][Ll][Uu][Tt][Ii][Oo][Nn]|[Hh][Ii][Dd][Dd][Ee][Nn]|[Ss][Cc][Oo][Rr](?:[Ee]|[Ii][Nn][Gg])[-_ ]?(?:[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Gg][Uu][Ii][Dd][Ee]))"}},"safeValue":{"anyOf":[{"type":["string","number","integer","boolean","null"]},{"type":"array","items":{"$ref":"#/$defs/safeValue"}},{"type":"object","propertyNames":{"$ref":"#/$defs/safeName"},"additionalProperties":{"$ref":"#/$defs/safeValue"}}]}}
}
