{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/schemas/reconciliation.schema.json",
  "title": "Critic finding reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "author", "decidedBy", "reviewedSha256", "decisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "author": { "type": "string", "minLength": 1 },
    "decidedBy": { "type": "string", "minLength": 1 },
    "reviewedSha256": { "$ref": "#/$defs/hash" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "decision", "rationale"],
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["accept", "reject-with-evidence", "escalate"] },
          "rationale": { "type": "string", "minLength": 1 },
          "fixedInSha256": { "$ref": "#/$defs/hash" }
        }
      }
    }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
