{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pep.local/schemas/legacy-course-packages.schema.json",
  "title": "Legacy course package hash index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authoritativePackage", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authoritativePackage": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "rootPath", "authoritative", "files"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "rootPath": { "type": "string", "pattern": "^/" },
          "authoritative": { "type": "boolean" },
          "files": {
            "type": "array",
            "items": { "$ref": "#/$defs/file" },
            "minItems": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "role"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)_work(?:/|$)).+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "role": {
          "enum": ["course-manifest", "course-catalog", "module-manifest", "learner-page"]
        }
      }
    }
  }
}
