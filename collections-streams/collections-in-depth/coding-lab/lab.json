{
  "schemaVersion": 1,
  "id": "collections-streams/collections-in-depth/coding-lab",
  "scope": "module",
  "covers": [
    "collections-streams/collections-in-depth/lists-sets-and-maps-in-depth",
    "collections-streams/collections-in-depth/stacks-and-queues",
    "collections-streams/collections-in-depth/generics",
    "collections-streams/collections-in-depth/big-o-basics",
    "collections-streams/collections-in-depth/the-equals-and-hashcode-contract",
    "collections-streams/collections-in-depth/how-hashmap-works"
  ],
  "objectives": [
    "collections-streams/collections-in-depth/lists-sets-and-maps-in-depth#o1",
    "collections-streams/collections-in-depth/lists-sets-and-maps-in-depth#o2",
    "collections-streams/collections-in-depth/stacks-and-queues#o1",
    "collections-streams/collections-in-depth/stacks-and-queues#o2",
    "collections-streams/collections-in-depth/generics#o1",
    "collections-streams/collections-in-depth/big-o-basics#o3",
    "collections-streams/collections-in-depth/the-equals-and-hashcode-contract#o2",
    "collections-streams/collections-in-depth/the-equals-and-hashcode-contract#o3",
    "collections-streams/collections-in-depth/how-hashmap-works#o3"
  ],
  "language": "Java 25 with Maven and JUnit Jupiter 6.1.3",
  "prerequisites": [
    { "tool": "JDK", "version": "25", "check": "java -version" },
    { "tool": "Apache Maven", "version": "3.9 or later", "check": "mvn -v" }
  ],
  "os": ["macos", "linux", "windows"],
  "network": { "setup": "once", "test": "none" },
  "setup": { "command": "mvn -q -Dmaven.test.failure.ignore=true clean test", "cwd": "starter" },
  "test": {
    "command": "mvn -q -o test",
    "cwd": "starter",
    "timeoutSeconds": 300,
    "starterExpectation": "fail",
    "failingTests": [
      "DeskTest.balancedBrackets",
      "DeskTest.nextOrNoneLooksWithoutRemoving",
      "DeskTest.serveUsesHeadForUrgentAndTailForOthers",
      "DeskTest.unbalancedBrackets",
      "OverlapTest.readsEachListOnceWhenEveryNameIsShared",
      "OverlapTest.readsListBInASinglePass",
      "OverlapTest.usesHashLookupsWithNoScanInsideTheLoop",
      "PairTest.lastOfReturnsTheElementType",
      "PairTest.storesTwoValuesOfDifferentTypes",
      "PairTest.swapReversesTheTypesToo",
      "SeatTest.aSeatWithNoRowYetIsComparedSafely",
      "SeatTest.anEqualSeatIsFoundInAHashSetAndAsAHashMapKey",
      "SeatTest.equalSeatsHaveEqualHashCodes",
      "SeatTest.equalsFollowsTheContract",
      "ShelfTest.copiesOfReturnsStockOrZero",
      "ShelfTest.removeBlankRemovesEmptyAndSpaceOnlyTitlesInPlace",
      "ShelfTest.uniqueInOrderKeepsFirstAppearanceOrder",
      "TallyTest.countOfAnEmptyListIsEmpty",
      "TallyTest.countsEveryWord",
      "TallyTest.groupsByInitialKeepingInputOrder"
    ]
  },
  "fixtures": { "seed": 0, "files": ["fixtures/words.txt"] },
  "expectedOutput": "expected/passing-summary.txt",
  "cleanup": {
    "paths": ["starter/target"],
    "notes": "Run mvn -q -o clean in starter/ to delete starter/target. The one-time setup also fills the learner's local Maven repository (~/.m2/repository) with the pinned plugins and JUnit; that shared cache is left in place on purpose."
  },
  "minutes": { "F25": 35, "F26": 12 },
  "trackRequirement": { "foundation": "required", "standard": "required", "fast": "not-required" },
  "platform": { "handoff": "bundle", "adapter": null },
  "licensing": []
}
