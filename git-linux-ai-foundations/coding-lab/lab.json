{
  "schemaVersion": 1,
  "id": "git-linux-ai-foundations/coding-lab",
  "scope": "course",
  "covers": [
    "git-linux-ai-foundations/git-foundations/commits-diffs-and-gitignore",
    "git-linux-ai-foundations/git-foundations/branches-and-switching",
    "git-linux-ai-foundations/git-foundations/merge-conflicts",
    "git-linux-ai-foundations/linux-foundations/environment-variables-and-secrets",
    "git-linux-ai-foundations/ai-foundations/checking-ai-changes",
    "git-linux-ai-foundations/ai-foundations/foundations-course-check"
  ],
  "objectives": [
    "git-linux-ai-foundations/git-foundations/commits-diffs-and-gitignore#o2",
    "git-linux-ai-foundations/git-foundations/commits-diffs-and-gitignore#o3",
    "git-linux-ai-foundations/git-foundations/branches-and-switching#o2",
    "git-linux-ai-foundations/git-foundations/merge-conflicts#o3",
    "git-linux-ai-foundations/linux-foundations/environment-variables-and-secrets#o3",
    "git-linux-ai-foundations/ai-foundations/checking-ai-changes#o1",
    "git-linux-ai-foundations/ai-foundations/checking-ai-changes#o2",
    "git-linux-ai-foundations/ai-foundations/checking-ai-changes#o3",
    "git-linux-ai-foundations/ai-foundations/foundations-course-check#o2",
    "git-linux-ai-foundations/ai-foundations/foundations-course-check#o3"
  ],
  "language": "python",
  "prerequisites": [
    { "tool": "git", "version": ">=2.23", "check": "git --version" },
    { "tool": "python", "version": ">=3.11", "check": "python --version" }
  ],
  "os": ["macos", "linux", "windows"],
  "network": { "setup": "none", "test": "none" },
  "setup": { "command": "python tests/setup_lab.py", "cwd": "." },
  "test": {
    "command": "python -m unittest discover -s tests -v",
    "cwd": ".",
    "timeoutSeconds": 30,
    "starterExpectation": "fail",
    "failingTests": [
      "test_reads_deploy_env_and_has_default",
      "test_env_file_is_ignored_and_untracked",
      "test_feature_commit_is_focused",
      "test_expected_feature_branch_is_checked_out",
      "test_prepared_branch_is_merged",
      "test_merge_is_resolved_without_markers",
      "test_worktree_is_clean_except_ignored_files"
    ]
  },
  "fixtures": {
    "seed": 0,
    "files": [
      "fixtures/initial/status_message.py",
      "fixtures/initial/.gitignore",
      "fixtures/initial/.env.example",
      "fixtures/initial/README.md",
      "fixtures/initial/PROPOSAL.md",
      "fixtures/copy-update/status_message.py",
      "fixtures/proposal/status_message.py",
      "fixtures/local-env.txt"
    ]
  },
  "expectedOutput": "expected/on-completion.txt",
  "cleanup": {
    "paths": [
      "starter/ship-safe-change/.git",
      "starter/ship-safe-change/.env",
      "starter/ship-safe-change/__pycache__",
      "tests/__pycache__"
    ],
    "notes": "Run python tests/cleanup_lab.py from the lab folder. It removes only these paths after checking each stays inside the lab, restores the shipped starter files from fixtures/, and never reads or changes global Git config. Re-running setup is a reset, not cleanup. The expected output file writes the variable run time as <seconds>."
  },
  "minutes": { "median": 18, "cap": 20 },
  "trackRequirement": { "standard": "required", "fast": "not-required" },
  "platform": { "handoff": "bundle", "adapter": null },
  "licensing": []
}
