{
  "schemaVersion": 1,
  "id": "sql-jdbc-foundations/relational-design/coding-lab",
  "scope": "module",
  "covers": [
    "sql-jdbc-foundations/relational-design/tables-keys-and-relationships",
    "sql-jdbc-foundations/relational-design/designing-tables-from-a-user-story",
    "sql-jdbc-foundations/relational-design/create-table-data-types-and-constraints"
  ],
  "objectives": [
    "sql-jdbc-foundations/relational-design/tables-keys-and-relationships#o1",
    "sql-jdbc-foundations/relational-design/tables-keys-and-relationships#o2",
    "sql-jdbc-foundations/relational-design/tables-keys-and-relationships#o3",
    "sql-jdbc-foundations/relational-design/designing-tables-from-a-user-story#o2",
    "sql-jdbc-foundations/relational-design/create-table-data-types-and-constraints#o1",
    "sql-jdbc-foundations/relational-design/create-table-data-types-and-constraints#o2",
    "sql-jdbc-foundations/relational-design/create-table-data-types-and-constraints#o3"
  ],
  "language": "SQL (PostgreSQL 18), tested with Java 25",
  "prerequisites": [
    { "tool": "PostgreSQL server and psql", "version": "18 (16 or later)", "check": "psql -d postgres -c \"SELECT version();\"" },
    { "tool": "JDK", "version": "25", "check": "java -version" },
    { "tool": "Apache Maven", "version": "3.9 or later", "check": "mvn -v" }
  ],
  "os": ["macos", "linux", "windows"],
  "network": { "setup": "once", "test": "none" },
  "setup": { "command": "mvn -q dependency:go-offline", "cwd": "starter" },
  "test": {
    "command": "mvn -q -o test",
    "cwd": "starter",
    "timeoutSeconds": 300,
    "starterExpectation": "fail",
    "failingTests": [
      "relational.SchemaTest.task1Tables",
      "relational.SchemaTest.task2Students",
      "relational.SchemaTest.task3Courses",
      "relational.SchemaTest.task4EnrollmentKeys",
      "relational.SchemaTest.task5EnrollmentDefaults"
    ]
  },
  "fixtures": { "seed": 0, "files": [] },
  "expectedOutput": "expected/test-summary.txt",
  "cleanup": {
    "paths": ["starter/target", "postgresql database relational_design_lab"],
    "notes": "The tests create the PostgreSQL database relational_design_lab on the learner's local server and drop it when they finish; after an interrupted run, psql -d postgres -c \"DROP DATABASE IF EXISTS relational_design_lab;\" removes it. Delete starter/target to remove compiled classes and test reports. Setup also downloads the pinned pgJDBC driver, JUnit and Maven plugins into the learner's local Maven repository (~/.m2/repository by default); that shared cache is kept for later labs and is not removed by cleanup."
  },
  "minutes": { "setup": 10, "tasks": 30 },
  "trackRequirement": { "foundation": "not-required" },
  "platform": { "handoff": "bundle", "adapter": null },
  "licensing": [
    "Starter, tests and README: original work for this repository.",
    "pgJDBC, the PostgreSQL JDBC driver (BSD-2-Clause), JUnit Jupiter and the JUnit Platform launcher (Eclipse Public License 2.0) and Apache Maven plugins (Apache License 2.0) are downloaded by Maven at setup; none is committed."
  ]
}
