# Platform-only material: answer keys, rubrics, hidden tests, reference solutions.
# It lives in uncommitted private staging; these patterns are a backstop.
platform-only/
**/platform-only/

# Legacy and scratch work trees
_work/
**/_work/

# Directory patterns below are anchored to tooling roots and the top of each lab and lab starter,
# so content slugs and lab fixtures/ or expected/ trees never collide with them.

# Screenshots and browser QA output (CI artifacts only)
Screenshot*.png
screenshot-*.png
screenshot_*.png
/screenshots/
/workflow/tools/**/screenshots/
/workflow/tests/**/screenshots/
/workflow/components/**/screenshots/
**/coding-lab/screenshots/
**/coding-lab/starter/screenshots/
