  "language": "Java 25",
  "prerequisites": [
    { "tool": "JDK", "version": "25", "check": "java -version" },
    { "tool": "Apache Maven", "version": "3.9 or later", "check": "mvn -v" }
  ],
  "os": ["macos", "linux", "windows"],
  "network": { "setup": "once", "test": "none" },
  "setup": { "command": "mvn -q dependency:go-offline", "cwd": "starter" },
  "test": {
    "command": "mvn -q -o test",
    "cwd": "starter",
    "timeoutSeconds": 300,
    "starterExpectation": "fail",
    "failingTests": [
      "basics.BasicsTest.task1Average",
      "basics.BasicsTest.task2Initials",
      "basics.BasicsTest.task3Even",
      "basics.BasicsTest.task4Grade",
      "basics.BasicsTest.task5Day",
      "basics.BasicsTest.task6Countdown"
    ]
  },
  "fixtures": { "seed": 0, "files": [] },
  "expectedOutput": "expected/test-summary.txt",
  "cleanup": {
    "paths": ["starter/target"],
    "notes": "Delete starter/target to remove compiled classes and test reports. Setup also downloads the pinned Maven plugins and JUnit into the learner's local Maven repository (~/.m2/repository by default); that shared cache is kept for later Java labs and is not removed by cleanup."
  },
  "minutes": { "setup": 10, "tasks": 35 },
  "trackRequirement": { "foundation": "not-required" },
  "platform": { "handoff": "bundle", "adapter": null },
